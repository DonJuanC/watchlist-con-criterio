# Neon.tech — PostgreSQL con pgvector (Free Tier, 500 MB)
# Formato: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# TMDB API (Free Tier) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini API (Google AI Studio, Free Tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Notion — integración interna con acceso a la base "🎬 Películas & Series"
NOTION_TOKEN=ntn_your_integration_secret_here
NOTION_DATA_SOURCE_ID=your_data_source_id_here
